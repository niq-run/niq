# Anything ignored below is re-included only by an explicit negation.
# Keep rule ordering: a later rule can un-ignore an earlier one.

# OS / editor cruft
.DS_Store

# Local builds
bin/
# This committed npm shim must not be swept up by `bin/` above.
!app/publish/npm/bin/

# GoReleaser output (repo root)
/dist/
# NOTE: the shell's assets/dist is go:embed'd and MUST stay committed, so it is
# deliberately NOT ignored (a rebuild only changes it when the UI changed:
# vite bundles are content-hashed).

# npm / node build artifacts
**/node_modules/
# worker-sdk (@niq.run/worker-sdk) node project
sdk/ts/dist/

# Frontend caches (any shell's assets)
**/assets/.vite/
# tsc's incremental build cache. Build state, not shipped output (the embedded
# artifact is assets/dist): it is machine- and filesystem-dependent, and one
# generated on a case-insensitive filesystem keeps stale paths across a
# case-only rename — it listed ./src/app.tsx while the tree has src/App.tsx, so
# macOS builds never rewrote it (both names resolve to the same file) and every
# Linux build did, showing up as a diff.
**/assets/*.tsbuildinfo
