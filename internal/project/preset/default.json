{
  "workers": [
    {
      "type": "reason",
      "id": "niq",
      "subscriptions": [
        "worker.input",
        "tool.completed",
        "tool.failed",
        "tool.rejected",
        "worker.ready",
        "worker.gone",
        "worker.discover",
        "worker.abort",
        "timer.timeout",
        "timer.reminder",
        "tool.request",
        "decision.made"
      ]
    },
    { "type": "timer", "id": "timer" },
    { "type": "host", "id": "host" },
    { "type": "program", "id": "program", "subscriptions": ["tool.request", "worker.discover"] }
  ]
}
