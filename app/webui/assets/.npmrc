# package-lock.json records absolute tarball URLs, so by default (npm's
# replace-registry-host=npmjs) an install follows whichever host wrote the lock —
# a machine on another network then stalls fetching from that mirror. "always"
# makes npm rewrite those hosts to this machine's configured registry, so
# `npm ci` is fast both in CN (npmmirror) and elsewhere (npmjs).
replace-registry-host=always
