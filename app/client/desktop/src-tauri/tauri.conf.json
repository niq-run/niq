{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "niq",
  "version": "0.1.0",
  "identifier": "run.niq.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "url": "index.html",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/niq"],
    "category": "DeveloperTool",
    "shortDescription": "niq desktop",
    "longDescription": "A shell that launches the niq CLI and opens the gateway's own WebUI."
  }
}
